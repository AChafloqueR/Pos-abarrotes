# Copia este archivo a .env.local y completa con los valores de tu proyecto
# Supabase (Project Settings > API). NUNCA subas .env.local a git — ya está
# en .gitignore. En Vercel, estas mismas variables van en
# Project Settings > Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# La service_role key SOLO se usa en el futuro para Edge Functions o rutas
# de servidor que administren usuarios (invitar cajeros). Jamás debe llevar
# el prefijo NEXT_PUBLIC_ ni exponerse al navegador.
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta
